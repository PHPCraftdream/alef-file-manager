{
  "name": "alef-file-manager",
  "version": "0.1.0",
  "private": true,
  "description": "File manager application for the Alef runtime",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config .oxlintrc.json src --max-warnings 0"
  },
  "dependencies": {
    "@alef-runtime/api": "0.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "i18next": "26.4.2",
    "react-i18next": "17.0.15"
  },
  "devDependencies": {
    "@alef-runtime/tools": "0.1.0",
    "@rsbuild/core": "2.2.9",
    "@rsbuild/plugin-react": "2.1.0",
    "@rsbuild/plugin-tailwindcss": "2.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.13.6",
    "oxlint": "1.85.0"
  },
  "alef-runtime": {
    "dev": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "build": "npm run build",
    "outDir": "dist"
  }
}
